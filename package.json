{
  "name": "liquid-glass-engine",
  "version": "0.1.0-alpha.1",
  "description": "Framework-agnostic Liquid Glass standard library for native DOM controls. WebGPU-first, WebGL2 compatible, zero CSS required.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarsailsClover/LiquidGlassEngine.git"
  },
  "homepage": "https://github.com/StarsailsClover/LiquidGlassEngine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @lge/demo dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "shaders:embed": "node _scripts/embed-shaders.mjs",
    "verify:dom-glass": "node apps/demo/e2e/verify.mjs --renderer=auto --lane=auto",
    "verify:webgpu": "node apps/demo/e2e/verify.mjs --renderer=webgpu --lane=auto",
    "verify:webgl2": "node apps/demo/e2e/verify.mjs --renderer=webgl2 --lane=auto",
    "verify:lane-b": "node apps/demo/e2e/verify.mjs --renderer=webgpu --lane=B",
    "verify:components": "node apps/demo/e2e/components.mjs",
    "visual:update": "node apps/demo/e2e/verify.mjs --renderer=webgpu --lane=auto --update-baseline && node apps/demo/e2e/verify.mjs --renderer=webgl2 --lane=auto --update-baseline && node apps/demo/e2e/verify.mjs --renderer=webgpu --lane=B --update-baseline"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/node": "^24.3.0",
    "@webgpu/types": "^0.1.69",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
